{
    email slinger@slingerjansen.nl
}
trustseco2.science.uu.nl {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    @submissions {
        method POST
        path /api/pilot/event /api/pilot/join
    }
    handle @submissions {
        reverse_proxy https://trustseco1.science.uu.nl {
            header_up Host trustseco1.science.uu.nl
        }
    }
    handle /reviewer/* {
        reverse_proxy https://trustseco1.science.uu.nl {
            header_up Host trustseco1.science.uu.nl
        }
    }
    handle {
        reverse_proxy web:3000
    }
}
