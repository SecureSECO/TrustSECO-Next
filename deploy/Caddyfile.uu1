{
    email {$ACME_EMAIL}
}
{$PUBLIC_HOST} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    handle_path /reviewer/* {
        root * /srv/reviewer
        file_server
    }
    handle {
        reverse_proxy web:3000
    }
}
